{
  "name": "@jhizzard/mnestra",
  "version": "0.13.0",
  "description": "Persistent developer memory MCP server — the LLM is stateless, Mnestra isn't",
  "license": "MIT",
  "author": "Joshua Izzard <jhizzard@gmail.com>",
  "homepage": "https://github.com/jhizzard/mnestra",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhizzard/mnestra.git"
  },
  "bugs": {
    "url": "https://github.com/jhizzard/mnestra/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "mnestra": "./dist/mcp-server/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-js-assets.mjs dist",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "tsc -p tsconfig.tests.json && node scripts/copy-js-assets.mjs dist-tests && MNESTRA_DISABLE_RECALL_LOG=1 node --test 'dist-tests/tests/**/*.test.js'",
    "start": "node dist/mcp-server/index.js"
  },
  "keywords": [
    "mcp",
    "memory",
    "rag",
    "claude",
    "cursor",
    "llm",
    "supabase",
    "pgvector",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.49.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.0",
    "pg": "^8.22.0",
    "typescript": "^6.0.3"
  }
}
